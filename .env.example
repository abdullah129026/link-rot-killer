# Copy to .env.local and fill in values.
# SUPABASE_URL is the server-side project URL; NEXT_PUBLIC_SUPABASE_URL is
# the same value, exposed to the browser for magic-link sign-in.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=
